# --- Baza danych (Supabase: Project Settings → Database → Connection pooling, tryb "Transaction", port 6543) ---
DATABASE_URL=postgres://app:app@localhost:5432/klub
# "require" dla Supabase (połączenie szyfrowane), puste lokalnie
DATABASE_SSL=
DB_POOL_MAX=5

# Publiczny adres aplikacji (linki w e-mailach, powroty z płatności)
APP_URL=http://localhost:3000

# Klucz do szyfrowania danych dostępowych operatorów płatności (min. 32 znaki, losowy):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=zmien-mnie-na-losowy-ciag-min-32-znaki-xxxxxxxx

# Płatności testowe (symulator zamiast Przelewy24). W produkcji zostaw "false".
ALLOW_MOCK_PAYMENTS=true

# E-maile transakcyjne (Resend). Bez klucza e-maile trafiają do logów.
RESEND_API_KEY=
MAIL_FROM="Klubowy <bilety@twojadomena.pl>"

# Sekret dla zadań cyklicznych Vercel Cron (raport poranny)
CRON_SECRET=

# Własne domeny klubów: domena=slug-klubu, rozdzielone przecinkami
CUSTOM_DOMAINS=
