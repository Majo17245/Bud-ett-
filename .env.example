# Skopiuj do pliku .env i uzupełnij:  cp .env.example .env
# Klucze API: TYLKO uprawnienia do handlu (Contract: Orders + Positions). BEZ wypłat i transferów.
# Najlepiej z ograniczeniem do Twojego adresu IP.

# Bybit Testnet (https://testnet.bybit.com) - używane przy mode: testnet
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Bybit mainnet - używane WYŁĄCZNIE przy mode: live (+ live_confirm: true)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Telegram (opcjonalnie): token od @BotFather i Twój chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Coinglass API v4 (opcjonalnie; heatmapa likwidacji wymaga płatnego planu)
COINGLASS_API_KEY=
